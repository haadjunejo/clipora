# Copy this file to `clipora.env` (same folder as run_server.py) and fill in what you need.
# On Kaggle/Colab you can add these as Secrets instead, or upload clipora.env in a PRIVATE dataset.
# One setting per line, no spaces around "=", no quotes. NEVER commit or share your real clipora.env.

# --- Required when the site is reachable from the internet ---
APP_PASSWORD=choose-a-strong-password

# --- Free AI keys (any or none; Clipora rotates between them and falls back to a rule-based picker) ---
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Publish to YouTube (docs/youtube.md) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Saved from Connections → "Save it as a secret", keeps you connected across sessions
YOUTUBE_REFRESH_TOKEN=

# --- Publish to Instagram + Facebook (docs/instagram-facebook.md) ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_TOKEN=

# --- Optional ---
# Your own domain, e.g. https://clips.example.com (makes YouTube/Facebook sign-in return automatically)
PUBLIC_URL=
# Where projects are stored (default: ./data, or /kaggle/working/clipora-data on Kaggle)
# CLIPORA_DATA=/path/to/data
# Whisper models: normal videos / long streams
# WHISPER_MODEL=large-v3
# WHISPER_LONG_MODEL=large-v3-turbo
